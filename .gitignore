# OAuth/OIDC signing keys. The instance-local key provider writes a private key per process under
# backend/keys/instances/<instance-id>/, so the whole tree is ignored rather than a file pattern:
# a key written in any other format cannot then slip through.
backend/keys/
frontend/keys/
*.pem

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
test-results/
test/.playwright-report/
kube.env

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm
.eslintcache
.stylelintcache
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

# Next.js build output
.next
out
frontend/next-env.d.ts

# Compiled output
dist
.output

# IDE, AI tooling, agent transcripts
CLAUDE.md
.claude
.agents
skills-lock.json
tmp
.vscode-test

# corp SSO session harvest (tools/corp.mjs), personal session credentials, never commit
.corp/
