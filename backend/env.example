# The identity and access authority.
#
# Every variable is prefixed GIAM_ and nothing here is derived from another service's configuration.
# The runbook explains the reasoning behind each group; this file is what you copy.
#
# The shortest working setup is three lines: a database URI, a master key, and the encryption
# library path. Everything else has a default that is correct for a single instance.

# ── Storage ────────────────────────────────────────────────────────────────────────────────────
# Sharing a cluster is not sharing a database. This authority never reads another service's
# collections and no other service reads its.
GIAM_DB_URI=mongodb://localhost:27017
GIAM_DB_NAME=giamdb
# The key vault is a COLLECTION inside that same database, with this authority's own DEKs. It is
# never the vault the applications share: an identity system holding the same key material as the
# thing it protects has no compromise-containment story to tell.
GIAM_DB_KEYVAULT=keyVault
# Required. A wrong or missing path fails the whole database connection and surfaces as a generic
# 503 on every route, which is expensive to diagnose, so it is checked at startup instead.
GIAM_CRYPT_SHARED_LIB_PATH=/usr/local/lib/mongo_crypt_v1.so
# Substring search on encrypted names. Needs server AND library 8.2 or later; leave it false below that.
GIAM_QE_TEXT_SEARCH=true

# ── The master key ─────────────────────────────────────────────────────────────────────────────
# 96 random bytes, base64. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(96).toString('base64'))"
#
# NOT ROTATABLE IN PLACE. Everything under queryable encryption is written under this key, so
# changing or losing it makes the database unreadable and the only recovery is --reset plus reseed.
# That is acceptable HERE and only here, because setup and seed are the only way this database is
# built and every record is reproducible. It would not be acceptable for data you cannot regenerate.
GIAM_KMS_PROVIDER=local
GIAM_KMS_LOCAL_MASTER_KEY=

# With GIAM_KMS_PROVIDER=aws instead, the master key lives in a KMS and these apply:
# GIAM_KMS_AWS_CMK_ARN=
# GIAM_KMS_AWS_REGION=us-east-1

# ── Signing key custody ────────────────────────────────────────────────────────────────────────
# instance-local is the default and it is the one that scales: each replica holds its own key pair
# on its own node and publishes only the PUBLIC half, so a realm's key set is the union of them and
# a token signed by one replica verifies at any other. No KMS, no shared volume, no shared secret.
GIAM_KEY_PROVIDER=instance-local
# GIAM_KEY_STORE_DIR=./keys
# GIAM_INSTANCE_ID=            # defaults to the hostname
# GIAM_KEY_LEASE_SECONDS=300
# GIAM_KEY_HEARTBEAT_SECONDS=60
# Set this to AT LEAST the access-token lifetime. Shorter, and scaling down invalidates tokens that
# have not expired, which signs live users out for a reason nobody will connect to the deployment
# that caused it. The posture endpoint reports it as publication_grace_too_short.
# GIAM_KEY_PUBLICATION_GRACE_SECONDS=3600
# Declared replica count. Used to REPORT posture, never to refuse to start.
# GIAM_REPLICAS=1
# Required by shared-store custody only.
# GIAM_KEY_WRAPPING_KEY=
# Required by kms custody only.
# GIAM_KEY_AWS_KEY_ARN=

# ── Operations ─────────────────────────────────────────────────────────────────────────────────
GIAM_PORT=8085
# Private, service to service. What a resource server resolves discovery against.
GIAM_BASE_URL=http://127.0.0.1:8085
# Public. A realm's issuer URL is built from this, and an issuer that does not match what clients
# were configured with fails every verification, so set it deliberately in any real deployment.
GIAM_PUBLIC_URL=http://localhost:8085
GIAM_FRONTEND_URL=http://localhost:8086
GIAM_CORS_ORIGIN=http://localhost:8086
# The credential for /admin/*, which includes SCIM provisioning and client registration.
#
# UNSET MEANS CLOSED, not open. An unconfigured administrative surface refuses every call with 503
# rather than publishing diagnostics to whoever asks because nobody set a variable. It refuses
# identically in every deployment, because no behaviour here depends on which environment this is.
GIAM_ADMIN_TOKEN=

# ── Federating an upstream provider ────────────────────────────────────────────────────────────
# A provider record names the variable its secret is read from, so the record can be shown to an
# operator without showing them a credential. The seeded example expects this one.
# GIAM_FEDERATION_PARTNERBANK_SECRET=

# ── Building the database ──────────────────────────────────────────────────────────────────────
# setup/ and seed/ are the ONLY supported way. There is no manual migration and no ad-hoc script.
#
#   npm run setup:db            # create collections, indexes, DEKs
#   npm run setup:db -- --reset # drop and rebuild
#   npm run setup:seed          # reference and demo records
#   npm run setup:check         # validate
#
# Setup SKIPS a collection that already exists, so changing an encrypted-fields map in code does
# nothing to a live collection: the field keeps its old configuration and no read complains. Changing
# one needs --reset or a drop of that collection. setup:check detects the drift and says so.

# ── Event delivery ─────────────────────────────────────────────────────────────────────────────
# Security events are recorded regardless; this is how they are DELIVERED onward. in-process is the
# default and needs no broker, which is why a single-node deployment has nothing to install.
# GIAM_EVENT_BUS_ENGINE=in-process
# GIAM_EVENT_BUS_TOPIC_PREFIX=giam
#
# With kafka:
# GIAM_KAFKA_BROKERS=localhost:9092
# GIAM_KAFKA_CLIENT_ID=giam
# GIAM_KAFKA_SSL=false
# GIAM_KAFKA_SASL_MECHANISM=
# GIAM_KAFKA_SASL_USERNAME=
# GIAM_KAFKA_SASL_PASSWORD=
#
# With rabbitmq:
# GIAM_RABBITMQ_URL=amqp://localhost

# ── The rest ───────────────────────────────────────────────────────────────────────────────────
# Where the seeder reads its fixtures from. Set in a container where they are not beside the code.
# GIAM_SEED_DATA_DIR=
# The API reference at /doc. Serving it is a configuration choice, never an environment check: the
# document describes the contract, and hiding it does not make an endpoint any less reachable.
# GIAM_DOCS_ENABLED=true
# Only when signing keys are held in a KMS.
# GIAM_KEY_AWS_REGION=us-east-1
